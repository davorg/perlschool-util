#!/usr/bin/env bash
set -euo pipefail

# Default image name; override with IMAGE_NAME if needed
IMAGE_NAME="${IMAGE_NAME:-davorg/perlschool-util}"

VERSION_FILE="VERSION"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "Error: $VERSION_FILE not found in $(pwd) - this script reads the" >&2
  echo "version to build from a VERSION file in the repo root." >&2
  exit 1
fi

# Strip any surrounding whitespace/newline from the file content
VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"

# Enforce simple SemVer X.Y.Z
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: $VERSION_FILE must contain a SemVer version of the form X.Y.Z (got '${VERSION}')" >&2
  exit 1
fi

echo "Building ${IMAGE_NAME}:${VERSION} (and tagging :latest) ..."
docker build \
  --build-arg "VERSION=${VERSION}" \
  -t "${IMAGE_NAME}:${VERSION}" \
  -t "${IMAGE_NAME}:latest" \
  .

echo "Pushing ${IMAGE_NAME}:${VERSION} ..."
docker push "${IMAGE_NAME}:${VERSION}"

echo "Pushing ${IMAGE_NAME}:latest ..."
docker push "${IMAGE_NAME}:latest"

echo "Done."
